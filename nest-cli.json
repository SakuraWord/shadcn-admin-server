{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/shadch-admin/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/shadch-admin/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/shadch-admin",
  "projects": {
    "chat": {
      "type": "application",
      "root": "apps/chat",
      "entryFile": "main",
      "sourceRoot": "apps/chat/src",
      "compilerOptions": {
        "tsConfigPath": "apps/chat/tsconfig.app.json"
      }
    },
    "shadch-admin": {
      "type": "application",
      "root": "apps/shadch-admin",
      "entryFile": "main",
      "sourceRoot": "apps/shadch-admin/src",
      "compilerOptions": {
        "tsConfigPath": "apps/shadch-admin/tsconfig.app.json"
      }
    }
  }
}